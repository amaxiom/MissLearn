# Python
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Test / build artefacts
.pytest_cache/
build/
dist/

# Working material kept out of the repository
DRAFTS/

# Data downloaded on demand by the example notebooks
examples/example_data/

# Generated benchmark outputs (regenerate via the benchmark notebooks)
benchmarks/results/

# Sphinx build output (regenerated; never committed)
docs/_build/
docs/generated/
docs/auto_examples/
docs/sg_execution_times.rst

# Example Explorer run archives (regenerated per run)
examples/explorer_output/
benchmarks/explorer_output/

# Coverage report (regenerated by the test suite)
coverage.xml
.coverage

# Benchmark notebooks: generated from family_registry.py, deliberately not shipped
benchmarks/NOTEBOOKS/

# Local history of withdrawn code. Kept on disk because this tree has no
# version control, so an archived copy is the only way back; not published.
_archive/

# Hypothesis example database (regenerated; 1,574 files and pure cache)
.hypothesis/

# Session working directory, copied out of the temp path
# for access. Working material, not part of the package.
_session/
